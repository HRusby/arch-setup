# Colours (and the urgency border colours) come from the theme engine.
# The include must stay first: it applies to the global section.
include=~/.config/theme/generated/mako.conf

font=sans-serif 11
anchor=top-right
width=360
height=140
margin=12
padding=12
border-size=2
border-radius=6
icons=1
max-icon-size=48
default-timeout=6000
layer=overlay

[urgency=low]
default-timeout=3000

[urgency=critical]
default-timeout=0

[mode=do-not-disturb]
invisible=1
