#!/usr/bin/env bash
# Make limine-entry-tool's ${ESP_PATH}/limine.conf the one Limine config, and
# drop archinstall's stock kernel entries from it. Run as root, after
# limine-update has written its own entries.
#
# With limine-mkinitcpio-hook installed, kernels and initramfs images go only to
# ${ESP_PATH}/<machine-id>/<kernel>/; /boot/vmlinuz-* stop being updated, so
# archinstall's "boot():/vmlinuz-*" entries would boot a kernel whose modules
# are gone after the next upgrade. Limine reads the first limine.conf it finds
# (<EFI app path>/limine.conf before the ESP root), while limine-entry-tool
# writes only ${ESP_PATH}/limine.conf, so any other limine.conf on the ESP
# would shadow it.
#
# Nothing changes unless ${ESP_PATH}/limine.conf already holds this machine's
# entries from limine-entry-tool. Then:
#   * every other limine.conf on the ESP is renamed to limine.conf.disabled;
#   * top-level entries that limine-entry-tool didn't write, that have no
#     sub-entries and that boot boot():/vmlinuz-* are removed (other entries,
#     such as /Windows, are kept);
#   * if that made this machine's OS entry the first one, default_entry is set
#     to 2: its first kernel.
#
# Environment (tests): LIMINE_FUNCTIONS, LIMINE_MUTEX, MACHINE_ID_FILE,
# LIMINE_TIDY_NO_ROOT_CHECK=1.
set -euo pipefail

functions=${LIMINE_FUNCTIONS:-/usr/lib/limine/limine-common-functions}
mutex=${LIMINE_MUTEX:-/usr/lib/limine/limine-mutex}
machine_id_file=${MACHINE_ID_FILE:-/etc/machine-id}

die() {
    echo "limine-tidy-entries: $*" >&2
    exit 1
}

warn() {
    echo "limine-tidy-entries: $*" >&2
}

[[ -n ${LIMINE_TIDY_NO_ROOT_CHECK:-} ]] || (( EUID == 0 )) || die "must be run as root"

# ESP_PATH exactly as limine-entry-tool resolves it (its config files, then
# /efi, /boot, /boot/efi, /limine).
[[ -f $functions ]] || die "$functions not found (is limine-mkinitcpio-hook installed?)"
# shellcheck disable=SC1090
esp=$(set +eu; source "$functions" > /dev/null 2>&1; load_config > /dev/null 2>&1 && printf '%s' "$ESP_PATH") ||
    die "cannot determine ESP_PATH"
[[ -n $esp && -d $esp ]] || die "cannot determine ESP_PATH"
conf=$esp/limine.conf
mid=$(< "$machine_id_file")
[[ $mid =~ ^[0-9a-f]{32}$ ]] || die "no machine id in $machine_id_file"

if [[ -f $mutex ]]; then
    # shellcheck disable=SC1090
    source "$mutex"
    mutex_lock limine-tidy-entries
fi

if ! [[ -f $conf ]] ||
    ! grep -Eq "machine-id=$mid( |$)" "$conf" ||
    ! grep -q 'kernel entry is auto-generated by limine-entry-tool' "$conf"; then
    echo "WARNING: limine-tidy-entries: $conf has no entries from limine-entry-tool for this machine." >&2
    echo "WARNING: nothing changed. Run limine-update and check its output before the next kernel upgrade." >&2
    exit 1
fi

# Other configs Limine could read first (EFI/<dir>/, boot/limine/, limine/ ...).
while IFS= read -r -d '' other; do
    mv -f "$other" "$other.disabled"
    echo "limine-tidy-entries: ${other#"$esp/"} would shadow ${conf#"$esp/"}; renamed to limine.conf.disabled"
done < <(find "$esp" -mindepth 2 -maxdepth 3 -iname limine.conf -print0)

# Drop archinstall's stock kernel entries into $tmp; awk prints how many it dropped.
tmp=$(mktemp "$conf.XXXXXX")
trap 'rm -f "$tmp"' EXIT
removed=$(awk -v out="$tmp" '
    function flush(   i, drop) {
        drop = inblock && !sub_entries && !managed && stock_kernel
        if (drop) removed++
        else for (i = 1; i <= n; i++) print buf[i] > out
        n = 0; inblock = 0; sub_entries = 0; managed = 0; stock_kernel = 0
    }
    /^[[:space:]]*\/[^\/]/ { flush(); inblock = 1 }
    {
        buf[++n] = $0
        if (!inblock) { flush(); next }
        if ($0 ~ /^[[:space:]]*\/\//) sub_entries = 1
        if ($0 ~ /auto-generated by limine-entry-tool|machine-id=/) managed = 1
        if ($0 ~ /^[[:space:]]*(kernel_)?path:[[:space:]]*boot\(\):\/vmlinuz-/) stock_kernel = 1
    }
    END { flush(); print removed + 0 }
' "$conf")

if (( removed )); then
    echo "limine-tidy-entries: removed $removed stock boot():/vmlinuz-* entries"
    # Is this machine's OS entry now the first entry?
    first_is_ours=$(awk -v mid="$mid" '
        /^[[:space:]]*\// { if (seen) exit; seen = 1; next }
        seen && /^[[:space:]]*\/\// { exit }
        seen && index($0, "machine-id=" mid) { print 1; exit }
    ' "$tmp")
    if [[ $first_is_ours == 1 ]]; then
        awk '
            /^default_entry:/ { next }
            !done && /^[[:space:]]*\// { print "default_entry: 2"; print ""; done = 1 }
            { print }
        ' "$tmp" > "$tmp.d"
        # Keep the setting where it was if it already existed.
        if grep -q '^default_entry:' "$tmp"; then
            awk '
                /^default_entry:/ { if (!done) print "default_entry: 2"; done = 1; next }
                { print }
            ' "$tmp" > "$tmp.d"
        fi
        mv -f "$tmp.d" "$tmp"
    else
        warn "this machine's entry is not the first one; check default_entry in $conf"
    fi
fi

if cmp -s "$tmp" "$conf"; then
    echo "limine-tidy-entries: $conf already tidy"
    exit 0
fi
mv -f "$tmp" "$conf"
echo "limine-tidy-entries: updated $conf"

# Never fatal: the new config is already in place.
if command -v limine-enroll-config > /dev/null; then
    limine-enroll-config || warn "limine-enroll-config failed; run it by hand if you enroll the config hash"
fi
