#!/usr/bin/env bash
# Add a "/Windows" entry to limine.conf that chainloads Windows Boot Manager
# from an EFI system partition on another disk. Run as root.
#
# Usage: limine-windows-entry [--partuuid <uuid>]
#
# Only EFI system partitions (vfat, ESP partition type) on internal disks other
# than the one holding / are looked at: removable, hotplug and USB disks are
# skipped, so no entry is written for a stick that won't be there next boot.
# Each is mounted read-only (ro,nosuid,nodev,noexec) on a temporary directory
# and unmounted again: no other disk is ever written. Exactly one of them must
# hold EFI/Microsoft/Boot/bootmgfw.efi; with several, nothing is written and
# they are listed, so one can be picked with --partuuid. Re-running replaces
# the entry; when no Windows is found nothing is changed.
#
# Environment (mostly for tests):
#   LIMINE_CONF      config to edit (default: ${ESP_PATH}/limine.conf, with
#                    ESP_PATH resolved by limine-entry-tool's own load_config;
#                    without limine-entry-tool, ESP_PATH from LIMINE_DEFAULTS or
#                    else the single limine.conf found in the usual places)
#   LIMINE_FUNCTIONS limine-entry-tool's library (default: /usr/lib/limine/limine-common-functions)
#   LIMINE_DEFAULTS  file holding ESP_PATH= (default: /etc/default/limine)
#   LIMINE_MUTEX     limine-snapper-sync's boot partition lock library
#   LIMINE_WINDOWS_ENTRY_NO_ROOT_CHECK=1  skip the root check
set -euo pipefail

LOADER=EFI/Microsoft/Boot/bootmgfw.efi
ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
defaults=${LIMINE_DEFAULTS:-/etc/default/limine}
functions=${LIMINE_FUNCTIONS:-/usr/lib/limine/limine-common-functions}
mutex=${LIMINE_MUTEX:-/usr/lib/limine/limine-mutex}

die() {
    echo "limine-windows-entry: $*" >&2
    exit 1
}

warn() {
    echo "limine-windows-entry: $*" >&2
}

want=""
while (( $# )); do
    case $1 in
        --partuuid)
            [[ ${2:-} =~ ^[0-9a-fA-F-]{36}$ ]] || die "--partuuid needs a partition UUID"
            want=${2,,}
            shift 2 ;;
        *) die "usage: limine-windows-entry [--partuuid <uuid>]" ;;
    esac
done

[[ -n ${LIMINE_WINDOWS_ENTRY_NO_ROOT_CHECK:-} ]] || (( EUID == 0 )) || die "must be run as root"

# field <name> <lsblk -P line> — value of one KEY="value" pair.
field() {
    local re="(^| )$1=\"([^\"]*)\""
    [[ $2 =~ $re ]] && echo "${BASH_REMATCH[2]}"
    return 0
}

# root_disks — whole disks underneath / (through LUKS, LVM, RAID).
root_disks() {
    local src
    src=$(findmnt -nvo SOURCE /)
    [[ -n $src ]] || return 0
    lsblk -nsrpo NAME,TYPE "$src" | awk '$2 == "disk" { print $1 }'
}

# find_conf — the limine.conf to edit.
find_conf() {
    if [[ -n ${LIMINE_CONF:-} ]]; then
        echo "$LIMINE_CONF"
        return
    fi
    local esp="" line c found=()
    # limine-entry-tool writes ${ESP_PATH}/limine.conf: use its own resolution.
    if [[ -f $functions ]]; then
        # shellcheck disable=SC1090
        esp=$(set +eu; source "$functions" > /dev/null 2>&1; load_config > /dev/null 2>&1 && printf '%s' "$ESP_PATH") ||
            die "limine-entry-tool cannot determine ESP_PATH"
    elif [[ -f $defaults ]]; then
        while read -r line; do
            [[ $line =~ ^ESP_PATH=\"?([^\"]*)\"?$ ]] && esp=${BASH_REMATCH[1]}
        done < "$defaults"
    fi
    if [[ -n $esp ]]; then
        [[ -f $esp/limine.conf ]] || die "no limine.conf in ESP_PATH $esp"
        echo "$esp/limine.conf"
        return
    fi
    for c in /boot/limine.conf /boot/limine/limine.conf /boot/EFI/limine/limine.conf \
        /boot/EFI/BOOT/limine.conf /efi/limine.conf /efi/EFI/limine/limine.conf \
        /boot/efi/limine.conf /boot/efi/EFI/limine/limine.conf; do
        [[ -f $c ]] && found+=("$c")
    done
    (( ${#found[@]} == 1 )) || die "found ${#found[@]} limine.conf files (${found[*]:-none}); set LIMINE_CONF"
    echo "${found[0]}"
}

mapfile -t roots < <(root_disks)
(( ${#roots[@]} )) || die "cannot tell which disk holds /; not scanning"

mnt=$(mktemp -d)
mounted=0
cleanup() {
    (( mounted )) && umount "$mnt"
    rmdir "$mnt"
}
trap cleanup EXIT

mapfile -t rows < <(lsblk -Pnpo NAME,TYPE,FSTYPE,PARTUUID,PARTTYPE,PKNAME,MOUNTPOINT,RM,HOTPLUG,TRAN)

# Whole disks that are removable, hotplug or USB (TRAN is only set on the disk).
declare -A unfixed=()
for line in "${rows[@]}"; do
    [[ $(field TYPE "$line") == disk ]] || continue
    if [[ $(field RM "$line") == 1 || $(field HOTPLUG "$line") == 1 || $(field TRAN "$line") == usb ]]; then
        unfixed[$(field NAME "$line")]=1
    fi
done

found=()    # "<dev> <partuuid>" of every candidate holding the Windows loader
for line in "${rows[@]}"; do
    dev=$(field NAME "$line")
    disk=$(field PKNAME "$line")
    uuid=$(field PARTUUID "$line")
    ptype=$(field PARTTYPE "$line")
    [[ $(field TYPE "$line") == part && $(field FSTYPE "$line") == vfat && -n $uuid ]] || continue
    [[ ${ptype,,} == "$ESP_TYPE" ]] || continue
    [[ " ${roots[*]} " == *" $disk "* ]] && continue
    if [[ -n ${unfixed[$disk]:-} || $(field RM "$line") == 1 || $(field HOTPLUG "$line") == 1 ]]; then
        echo "limine-windows-entry: skipping $dev on removable/USB disk $disk"
        continue
    fi

    where=$(field MOUNTPOINT "$line")
    if [[ -z $where ]]; then
        mount -o ro,nosuid,nodev,noexec -t vfat "$dev" "$mnt" || { warn "could not mount $dev read-only; skipped"; continue; }
        mounted=1
        where=$mnt
    fi
    if [[ -f $where/$LOADER ]]; then
        found+=("$dev ${uuid,,}")
    fi
    if (( mounted )); then
        umount "$mnt"
        mounted=0
    fi
done

partuuid=""
if [[ -n $want ]]; then
    for f in "${found[@]}"; do
        [[ ${f#* } == "$want" ]] && partuuid=$want
    done
    if [[ -z $partuuid ]]; then
        die "--partuuid $want is not an internal ESP holding Windows Boot Manager (found: ${found[*]:-none})"
    fi
elif (( ${#found[@]} > 1 )); then
    warn "Windows Boot Manager found on several partitions; nothing written:"
    for f in "${found[@]}"; do
        echo "  ${f%% *}  PARTUUID=${f#* }" >&2
    done
    die "pick one with: limine-windows-entry --partuuid <uuid>"
elif (( ${#found[@]} == 1 )); then
    partuuid=${found[0]#* }
fi

if [[ -z $partuuid ]]; then
    echo "limine-windows-entry: no Windows found on other disks; limine.conf unchanged"
    exit 0
fi
echo "limine-windows-entry: using Windows Boot Manager on PARTUUID $partuuid"

conf=$(find_conf)
[[ -f $conf ]] || die "$conf does not exist"

# limine-snapper-sync asks other tools editing limine.conf to take its lock.
if [[ -f $mutex ]]; then
    # shellcheck disable=SC1090
    source "$mutex"
    mutex_lock limine-windows-entry
fi

# The config without any "/Windows" entry (up to the next entry line), trailing
# blank lines dropped so re-runs don't grow the file.
kept=$(awk '
    /^\/Windows[[:space:]]*$/ { skip = 1; next }
    skip && /^[[:space:]]*\// { skip = 0 }
    !skip { print }
' "$conf")
new=$(printf '%s\n\n%s\n' "$kept" "/Windows
### Written by limine-windows-entry; re-run it instead of editing this entry.
comment: Windows Boot Manager
protocol: efi
path: guid($partuuid):/$LOADER")

if [[ $new == "$(cat "$conf")" ]]; then
    echo "limine-windows-entry: $conf already up to date"
    exit 0
fi

tmp=$(mktemp "$conf.XXXXXX")
printf '%s\n' "$new" > "$tmp"
mv -f "$tmp" "$conf"
echo "limine-windows-entry: wrote /Windows entry to $conf"

# Re-enroll the config hash if the system enrolls one (no-op otherwise).
# Never fatal: the new config is already in place.
if command -v limine-enroll-config > /dev/null; then
    limine-enroll-config || warn "limine-enroll-config failed; run it by hand if you enroll the config hash"
fi
