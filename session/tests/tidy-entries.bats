load ../../tests/helpers

# The ESP is a temp dir. A fake limine-common-functions provides load_config,
# the function limine-entry-tool itself uses to find ESP_PATH.

MID=0123456789abcdef0123456789abcdef

setup() {
    sandbox
    TIDY="$REPO_ROOT/session/.local/bin/limine-tidy-entries"
    ESP="$FAKE_DIR/esp"
    mkdir -p "$FAKE_DIR/sys" "$ESP"
    for c in bash env cat grep sed awk mktemp rm find mkdir cp mv cmp dirname basename chmod; do
        ln -s "$(command -v "$c")" "$FAKE_DIR/sys/$c"
    done
    export PATH="$FAKE_DIR/bin:$FAKE_DIR/sys"
    export LIMINE_FUNCTIONS="$FAKE_DIR/limine-common-functions"
    printf 'load_config() { ESP_PATH=%q; }\n' "$ESP" > "$LIMINE_FUNCTIONS"
    export LIMINE_MUTEX="$FAKE_DIR/no-mutex"
    export MACHINE_ID_FILE="$FAKE_DIR/machine-id"
    echo "$MID" > "$MACHINE_ID_FILE"
    export LIMINE_TIDY_NO_ROOT_CHECK=1
}

# archinstall_entries — stock top-level entries as archinstall writes them.
archinstall_entries() {
    cat <<'EOF'
/Arch Linux (linux)
    protocol: linux
    path: boot():/vmlinuz-linux
    cmdline: root=/dev/mapper/root rw
    module_path: boot():/initramfs-linux.img

/Arch Linux (linux-fallback)
    protocol: linux
    kernel_path: boot():/vmlinuz-linux
    cmdline: root=/dev/mapper/root rw
    module_path: boot():/initramfs-linux-fallback.img

EOF
}

# managed_entries [machine-id] — an OS entry written by limine-entry-tool.
managed_entries() {
    cat <<EOF
/+Arch Linux
### This OS entry is auto-generated by limine-entry-tool
comment: machine-id=${1:-$MID} order-priority=50
  //linux
  ### This kernel entry is auto-generated by limine-entry-tool
  protocol: linux
  path: boot():/${1:-$MID}/linux/vmlinuz-linux
  module_path: boot():/${1:-$MID}/linux/initramfs-linux.img

EOF
}

others() {
    cat <<'EOF'
/Recovery
### This kernel entry is auto-generated by limine-entry-tool
protocol: linux
path: boot():/vmlinuz-linux

/My kernels
  //custom
  protocol: linux
  path: boot():/vmlinuz-linux-custom

/Memtest
    protocol: efi
    path: boot():/memtest86+/memtest.efi

/Windows
### Written by limine-windows-entry; re-run it instead of editing this entry.
comment: Windows Boot Manager
protocol: efi
path: guid(49c516e8-a6d5-4232-9da6-b5506efcb2dc):/EFI/Microsoft/Boot/bootmgfw.efi
EOF
}

@test "removes archinstall's linux entries once managed entries exist, keeps the rest" {
    { printf 'timeout: 5\ndefault_entry: 1\n\n'; archinstall_entries; managed_entries; others; } > "$ESP/limine.conf"
    run "$TIDY"
    [ "$status" -eq 0 ] || { echo "$output"; false; }
    conf=$(cat "$ESP/limine.conf")
    [[ $conf != *"Arch Linux (linux"* ]]
    [[ $conf != *"initramfs-linux-fallback.img"* ]]
    [[ $conf == *"/+Arch Linux"*"//linux"*"boot():/$MID/linux/vmlinuz-linux"* ]]
    [[ $conf == *"/Memtest"* ]]
    # Entries limine-entry-tool marked, or with sub-entries, are never removed.
    [[ $conf == *"/Recovery"* ]]
    [[ $conf == *"/My kernels"*"//custom"*"vmlinuz-linux-custom"* ]]
    [[ $conf == *"/Windows"*"bootmgfw.efi"* ]]
    grep -qx 'timeout: 5' "$ESP/limine.conf"
    # The managed OS entry is now first, so its first kernel (entry 2) is the default.
    [ "$(grep -c '^default_entry:' "$ESP/limine.conf")" = 1 ]
    grep -qx 'default_entry: 2' "$ESP/limine.conf"
    first_entry=$(grep -m1 '^[[:space:]]*/' "$ESP/limine.conf")
    [ "$first_entry" = "/+Arch Linux" ]
}

@test "re-run changes nothing" {
    { printf 'timeout: 5\n\n'; archinstall_entries; managed_entries; others; } > "$ESP/limine.conf"
    run "$TIDY"
    [ "$status" -eq 0 ]
    cp "$ESP/limine.conf" "$FAKE_DIR/after-first"
    run "$TIDY"
    [ "$status" -eq 0 ]
    cmp "$FAKE_DIR/after-first" "$ESP/limine.conf"
}

@test "managed entries missing: changes nothing and warns" {
    { printf 'timeout: 5\n\n'; archinstall_entries; others; } > "$ESP/limine.conf"
    cp "$ESP/limine.conf" "$FAKE_DIR/before"
    run "$TIDY"
    [ "$status" -ne 0 ]
    cmp "$FAKE_DIR/before" "$ESP/limine.conf"
    [[ $output == *WARNING* ]]
}

@test "an OS entry without kernel entries from limine-entry-tool does not count" {
    { archinstall_entries; printf '/+Arch Linux\ncomment: machine-id=%s\n' "$MID"; } > "$ESP/limine.conf"
    cp "$ESP/limine.conf" "$FAKE_DIR/before"
    run "$TIDY"
    [ "$status" -ne 0 ]
    cmp "$FAKE_DIR/before" "$ESP/limine.conf"
}

@test "managed entries of another machine do not count" {
    { archinstall_entries; managed_entries ffffffffffffffffffffffffffffffff; } > "$ESP/limine.conf"
    cp "$ESP/limine.conf" "$FAKE_DIR/before"
    run "$TIDY"
    [ "$status" -ne 0 ]
    cmp "$FAKE_DIR/before" "$ESP/limine.conf"
}

@test "managed config missing: changes nothing and warns" {
    mkdir -p "$ESP/EFI/limine"
    archinstall_entries > "$ESP/EFI/limine/limine.conf"
    run "$TIDY"
    [ "$status" -ne 0 ]
    [[ $output == *WARNING* ]]
    [ -f "$ESP/EFI/limine/limine.conf" ]
    [ ! -e "$ESP/limine.conf" ]
}

@test "split layout: the managed ESP_PATH/limine.conf becomes the only config" {
    mkdir -p "$ESP/EFI/limine" "$ESP/EFI/BOOT" "$ESP/boot/limine"
    { printf 'timeout: 5\n\n'; archinstall_entries; } > "$ESP/EFI/limine/limine.conf"
    archinstall_entries > "$ESP/EFI/BOOT/limine.conf"
    archinstall_entries > "$ESP/boot/limine/limine.conf"
    { printf 'timeout: 3\ndefault_entry: 2\n\n'; managed_entries; } > "$ESP/limine.conf"
    cp "$ESP/limine.conf" "$FAKE_DIR/managed-before"
    run "$TIDY"
    [ "$status" -eq 0 ] || { echo "$output"; false; }
    [ "$(find "$ESP" -iname limine.conf)" = "$ESP/limine.conf" ]
    # The other configs are renamed, not deleted.
    [ -f "$ESP/EFI/limine/limine.conf.disabled" ]
    [ -f "$ESP/EFI/BOOT/limine.conf.disabled" ]
    [ -f "$ESP/boot/limine/limine.conf.disabled" ]
    cmp "$FAKE_DIR/managed-before" "$ESP/limine.conf"
    [[ $output == *"EFI/limine/limine.conf"* ]]
}

@test "split layout without managed entries leaves every config alone" {
    mkdir -p "$ESP/EFI/limine"
    archinstall_entries > "$ESP/EFI/limine/limine.conf"
    printf 'timeout: 3\n' > "$ESP/limine.conf"
    run "$TIDY"
    [ "$status" -ne 0 ]
    [ -f "$ESP/EFI/limine/limine.conf" ]
    [ ! -e "$ESP/EFI/limine/limine.conf.disabled" ]
}

@test "re-enrolls the config only when it changed; a failure only warns" {
    { archinstall_entries; managed_entries; } > "$ESP/limine.conf"
    fake limine-enroll-config <<< 'exit 1'
    run "$TIDY"
    [ "$status" -eq 0 ]
    [ "$(calls limine-enroll-config | grep -c .)" = 1 ]
    [[ $output == *"limine-enroll-config failed"* ]]
    run "$TIDY"
    [ "$(calls limine-enroll-config | grep -c .)" = 1 ]
}

@test "refuses to run when ESP_PATH cannot be found" {
    printf 'load_config() { return 1; }\n' > "$LIMINE_FUNCTIONS"
    run "$TIDY"
    [ "$status" -ne 0 ]
}
