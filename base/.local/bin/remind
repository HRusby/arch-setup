#!/usr/bin/env bash
# Desktop reminders as transient user timers.
# Usage: remind <minutes> <message...> | remind list | remind clear
set -euo pipefail

case "${1:-}" in
    list)
        systemctl --user list-timers 'remind-*'
        ;;
    clear)
        systemctl --user list-units --type=timer --plain --no-legend 'remind-*' |
            awk '{print $1}' |
            while read -r unit; do
                [[ -n $unit ]] && systemctl --user stop "$unit"
            done
        ;;
    *)
        minutes="${1:-}"
        if ! [[ $minutes =~ ^[0-9]+$ ]] || (( $# < 2 )); then
            echo "usage: remind <minutes> <message...> | list | clear" >&2
            exit 2
        fi
        shift
        message="$*"
        systemd-run --user --on-active="${minutes}m" --unit="remind-$(date +%s)" \
            --description="$message" notify-send -u critical Reminder "$message"
        ;;
esac
